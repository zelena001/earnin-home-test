{
  "compilerOptions": {
    "target": "ES2020",                          // Modern JS target
    "module": "commonjs",                        // Node.js module system
    "lib": ["ES2020", "DOM"],                    // Include DOM for Playwright
    "strict": true,                              // Enable strict type checking
    "esModuleInterop": true,                     // For importing commonjs modules
    "skipLibCheck": true,                        // Skip checking node_modules
    "forceConsistentCasingInFileNames": true,   // File naming consistency
    "outDir": "dist",                            // Compiled JS output
    "rootDir": ".",                              // Root folder for TS
    "moduleResolution": "node",
    
    "resolveJsonModule": true
  },
  "include": [
    "tests/**/*.ts",
    "pages/**/*.ts",
    "utils/**/*.ts",
    "interfaces/**/*.ts",
    "mocks/**/*.ts",
    "fixtures/**/*.ts"
, "helpers/analyticsHelper.ts", "helpers/mockHelper.ts"  ],
  "exclude": [
    "node_modules",
    "dist",
    "test-results"
  ]
}
